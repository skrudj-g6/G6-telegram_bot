# Скопируйте в .env и задайте свои значения. Файл .env не коммитится.

# --- PostgreSQL ---
POSTGRES_USER=altyn
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=altyn_crown

# --- Backend ---
APP_ENV=development
LOG_LEVEL=INFO
# Часовой пояс приложения (IANA). Значение по умолчанию — вопрос Q-18.
APP_TIMEZONE=Asia/Almaty
# Код клуба в покерном приложении
CLUB_ID=692609
# Секрет внутренней авторизации бот → backend (не короче 16 символов).
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
BOT_SERVICE_TOKEN=change_me_long_random_secret
# Секрет подписи токенов входа сотрудников, минимум 32 символа (например: openssl rand -hex 32)
JWT_SECRET=change_me_to_a_random_string_of_at_least_32_chars

# Нужен только при запуске backend вне Docker (в Docker собирается в docker-compose.yml)
# DATABASE_URL=postgresql+psycopg://altyn:change_me_strong_password@localhost:5432/altyn_crown

# Источник автоматического курса USDT/KZT: coingecko | none (none — только ручной курс)
RATE_SOURCE=coingecko
# RATE_SOURCE_URL=https://api.coingecko.com/api/v3/simple/price

# --- Telegram-бот ---
# Токен из @BotFather. Прежний токен был опубликован в git: его нужно перевыпустить (AUDIT.md, S-1).
BOT_TOKEN=put_new_bot_token_here
# Ссылка-приглашение в клуб (кнопка «Открыть клуб») и контакт поддержки (необязательно)
CLUB_INVITE_URL=https://clubgg.app.link/mIiESaFVq2b
# Ссылка на Telegram-аккаунт админа для кнопки «Поддержка», например https://t.me/username
SUPPORT_URL=
# Пауза между ссылкой на клуб и кнопкой «Регистрация в кассе», секунд
JOIN_DELAY_SECONDS=10

# --- Production (docs/DEPLOY_VPS.md) ---
# Домен панели; нужен только для docker-compose.prod.yml (HTTPS через Caddy)
# DOMAIN=panel.example.com
# Бэкапы (scripts/backup.sh): сколько дней хранить и куда копировать (необязательно, rsync/scp)
# BACKUP_KEEP_DAYS=14
# BACKUP_REMOTE=user@backup-host:/srv/altyn-backups/
