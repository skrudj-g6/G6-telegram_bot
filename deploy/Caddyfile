# Caddy сам получает и продлевает сертификат Let's Encrypt для домена из .env (DOMAIN).
# Порты 80 и 443 должны быть открыты и домен должен указывать на этот сервер.
{$DOMAIN} {
	encode gzip
	# Всё идёт на контейнер панели: он раздаёт интерфейс и проксирует /admin/v1 на backend.
	reverse_proxy admin:80
}
